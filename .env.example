# ============================================================
# .env.example — Personal Expense Manager Phase 3
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git!
# ============================================================

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=personal_expense_manager
DB_USER=postgres
DB_PASSWORD=your_password_here

# Khi deploy lên cloud, dùng DATABASE_URL thay cho các biến trên
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_SECRET=your_refresh_secret_key_different_from_jwt
REFRESH_EXPIRES_DAYS=30

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── CORS (để * cho local, đặt domain thực khi deploy) ────────
CORS_ORIGIN=*

# ── Email (Nodemailer) ────────────────────────────────────────
# Option 1: Gmail (cần bật 2FA và tạo App Password)
# SMTP_SERVICE=gmail
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx   <- App Password (16 ký tự)
# FROM_EMAIL=Personal Expense Manager <your.email@gmail.com>

# Option 2: SMTP tùy chỉnh
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your_password

# ── Multi-Currency (tùy chọn) ─────────────────────────────────
# Đăng ký miễn phí tại https://www.exchangerate-api.com/
# Nếu không có key, hệ thống dùng tỷ giá cứng tự động
# EXCHANGE_RATE_API_KEY=your_api_key_here
